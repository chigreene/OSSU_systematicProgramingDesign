;; The first three lines of this file were inserted by DrRacket. They record metadata
;; about the language level of this file in a form that our tools can easily process.
#reader(lib "htdp-beginner-reader.ss" "lang")((modname space-game) (read-case-sensitive #t) (teachpacks ()) (htdp-settings #(#t constructor repeating-decimal #f #t none #f () #f)))
(define-struct space-game [ufo tank])
; Space-game is a structure (Number Number)
; (make-game u t)
;   - u is y coord of ufo
;   - t is x coord of tank
; (game-u )
; (game-t )
; (game? )

; A SpaceGame is a structure:
;   (make-space-game Posn Number). 
; interpretation (make-space-game (make-posn ux uy) tx)
; describes a configuration where the UFO is 
; at (ux,uy) and the tank's x-coordinate is tx